{
  "manifest_version": 3,
  "name": "ChatGPT-Prompt-Automator",
  "version": "5.1.1",
  "description": "Automatic ChatGPT image collage generator with background-tab resilience, new-image detection, automatic downloads, and prompt batching.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}